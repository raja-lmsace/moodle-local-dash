{{!
    @template local_dash/layout_accordion

    Example context (json):
    {
        "sitefullname": "Moodle - 311",
		"courseurl": "https://localhost/moodle/course/view.php?id=2"
    }
}}
{{< block_dash/layout }}
    {{$body}}
        <div id="accordion-{{uniqueid}}">
            {{#data.sections}}
                <div class="card">
                    <div class="card-header" id="heading-{{uniqueid}}-{{groupby}}">
                        <a href="javascript:void(0);">
                            <h5 class="mb-0" data-toggle="collapse" data-target="#collapse-{{uniqueid}}-{{groupby}}" aria-expanded="true" aria-controls="collapse-{{uniqueid}}-{{groupby}}">
                                {{{label}}}
                            </h5>
                        </a>
                    </div>

                    <div id="collapse-{{uniqueid}}-{{groupby}}" class="collapse" aria-labelledby="heading-{{uniqueid}}-{{groupby}}" data-parent="#accordion-{{uniqueid}}">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table dash-table">
                                    <thead>
                                        <tr>
                                            {{#first_child.data}}
                                                <th>{{get_label}}</th>
                                            {{/first_child.data}}
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {{#rows}}
                                        <tr>
                                            {{#data}}
                                                <td>{{{get_value}}}</td>
                                            {{/data}}
                                        </tr>
                                    {{/rows}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            {{/data.sections}}
        </div>
    {{/body}}
{{/ block_dash/layout }}
