{{!
    @template local_dash/layout_accordion2

    Example context (json):
    {
        "sitefullname": "Moodle - 311",
		"courseurl": "https://localhost/moodle/course/view.php?id=2"
    }
}}
{{< block_dash/layout }}
    {{$body}}
        {{#bootstrap4}}
            <div id="accordion-{{uniqueid}}">
                {{#data.sections}}
                    <div class="card">
                        <div class="card-header" id="heading-{{uniqueid}}-{{groupby}}">
                            <a href="javascript:void(0);">
                                <h5 class="mb-0" {{datatoggle}}="collapse" {{datatarget}}="#collapse-{{uniqueid}}-{{groupby}}" aria-expanded="true" aria-controls="collapse-{{uniqueid}}-{{groupby}}">
                                    {{{label}}}
                                </h5>
                            </a>
                        </div>

                        <div id="collapse-{{uniqueid}}-{{groupby}}" class="collapse" aria-labelledby="heading-{{uniqueid}}-{{groupby}}" data-parent="#accordion-{{uniqueid}}">
                            <div class="card-body">
                                {{#rows}}
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div class="icons-no-margin">
                                                    {{#preferences.field1_icon}}
                                                        {{{preferences.field1_icon}}}
                                                    {{/preferences.field1_icon}}
                                                    {{{field1}}}
                                                </div>
                                                <div class="icons-no-margin">
                                                    {{#preferences.field2_icon}}
                                                        {{{preferences.field2_icon}}}
                                                    {{/preferences.field2_icon}}
                                                    {{{field2}}}
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <div class="icons-no-margin">
                                                    {{#preferences.field3_icon}}
                                                        {{{preferences.field3_icon}}}
                                                    {{/preferences.field3_icon}}
                                                    {{{field3}}}
                                                </div>
                                                <div class="icons-no-margin">
                                                    {{#preferences.field4_icon}}
                                                        {{{preferences.field4_icon}}}
                                                    {{/preferences.field4_icon}}
                                                    {{{field4}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {{/rows}}
                            </div>
                        </div>
                    </div>
                {{/data.sections}}
            </div>
        {{/bootstrap4}}
        {{#bootstrap3}}
            <div class="panel-group" id="accordion-{{uniqueid}}" role="tablist" aria-multiselectable="true">
                {{#data.sections}}
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="heading-{{uniqueid}}-{{groupby}}">
                            <h4 class="panel-title">
                                <a role="button" {{datatoggle}}="collapse" data-parent="#accordion-{{uniqueid}}" href="#collapse-{{uniqueid}}-{{groupby}}" aria-expanded="false" aria-controls="collapse-{{uniqueid}}-{{groupby}}">
                                    {{{label}}}
                                </a>
                            </h4>
                        </div>
                        <div id="collapse-{{uniqueid}}-{{groupby}}" class="panel-collapse collapse" role="tabpanel" aria-labelledby="heading-{{uniqueid}}-{{groupby}}">
                            <div class="panel-body">
                                {{#rows}}
                                    <div class="panel">
                                        <div class="panel-body">
                                            <div class="justify-content-between">
                                                <div class="icons-no-margin pull-right">
                                                    {{#preferences.field2_icon}}
                                                        {{{preferences.field2_icon}}}
                                                    {{/preferences.field2_icon}}
                                                    {{{field2}}}
                                                </div>
                                                <div class="icons-no-margin">
                                                    {{#preferences.field1_icon}}
                                                        {{{preferences.field1_icon}}}
                                                    {{/preferences.field1_icon}}
                                                    {{{field1}}}
                                                </div>
                                            </div>
                                            <div class="justify-content-between">
                                                <div class="icons-no-margin pull-right">
                                                    {{#preferences.field4_icon}}
                                                        {{{preferences.field4_icon}}}
                                                    {{/preferences.field4_icon}}
                                                    {{{field4}}}
                                                </div>
                                                <div class="icons-no-margin">
                                                    {{#preferences.field3_icon}}
                                                        {{{preferences.field3_icon}}}
                                                    {{/preferences.field3_icon}}
                                                    {{{field3}}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {{/rows}}
                            </div>
                        </div>
                    </div>
                {{/data.sections}}
            </div>
        {{/bootstrap3}}
    {{/body}}
{{/ block_dash/layout }}
