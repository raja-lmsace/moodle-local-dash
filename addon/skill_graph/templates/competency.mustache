{{!
    @template dashaddon_course_enrols/enrolments

    Example context (json):
    {
        "error": "",
        "paginator": "",
        "data": {
            "contextid": 2015,
            "uniqueid": "158",
            "dataset": "[]",
            "datasetcount": 2,
            "datalabels": "['Analyze', 'Development', 'Testing', 'Deploy']",
            "colors": {
            "proficient": "rgb(235, 0, 247)",
            "achieved": "rgb(74, 233, 149)",
            "notachieved": "rgb(200, 248, 223)"
            }
        },
        "uniqueid": "63e200ba54a47",
        "is_totara": false,
        "bootstrap3": false,
        "bootstrap4": true,
        "noresult": "<p dir=\"ltr\" style=\"text-align:left;\"><br /></p>",
        "filter_form_html": "",
        "supports_filtering": false,
        "supports_pagination": false,
        "preferences": {
            "default_sort": "alpha",
            "filters": {
                "c_course_categories_condition": {
                    "enabled": "1",
