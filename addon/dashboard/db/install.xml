<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/dash/addon/dashboard/db" VERSION="20191217" COMMENT="XMLDB file for Moodle dashaddon/dashboard"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="dashaddon_dashboard_dash" COMMENT="Stores info on user defined dashboards.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Name of dashboard for display"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Context of dashboard."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="permission" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Type of permission to restrict dashboard access"/>
        <FIELD NAME="cohort_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="If permission type is cohort, restrict by this cohort"/>
        <FIELD NAME="roles" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="If permission type is roles, restrict by this role"/>
        <FIELD NAME="rolecontext" TYPE="int" LENGTH="9" NOTNULL="false" DEFAULT="1" SEQUENCE="false" COMMENT="Context for permission roles"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Unique short name for dashboard"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Description of this dash dashboard"/>
        <FIELD NAME="descriptionformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The format of the description field"/>
        <FIELD NAME="dashicon" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Icon of this dash dashboard"/>
        <FIELD NAME="dashthumbnailimage"  TYPE="int" LENGTH="15" NOTNULL="false" SEQUENCE="false" COMMENT="Thumbnail image of this dash dashboard"/>
        <FIELD NAME="dashbgimage"  TYPE="int" LENGTH="15" NOTNULL="false" SEQUENCE="false" COMMENT="Background image of this dash dashboard"/>
        <FIELD NAME="secondarynav" TYPE="int" LENGTH="2" NOTNULL="false" SEQUENCE="false" COMMENT="Show the dashboard link in course secondary navigation."/>
        <FIELD NAME="coredash" TYPE="int" LENGTH="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Show the dashboard link in course secondary navigation."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="contextid" UNIQUE="false" FIELDS="contextid"/>
        <INDEX NAME="shortname" UNIQUE="true" FIELDS="shortname"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
