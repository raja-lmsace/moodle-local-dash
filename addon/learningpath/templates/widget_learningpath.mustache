{{!
    @template dashaddon_learningpath/widget_learningpath

    This template for text track tab

    Variables optional for this template:

    Example context (json):
    {
    }

}}
{{#data.showlearningpath}}
<div class="learning-path-widget dash-learning-path {{#data.showinfosidebar}}sidebar{{/data.showinfosidebar}}" data-blockid="{{blockid}}">

    {{#data.showinfotop}}
        <div class="learning-path-header alert {{#data.completedlearingpath}} alert-success{{/data.completedlearingpath}}{{^data.completedlearingpath}} alert-secondary{{/data.completedlearingpath}}">
            {{#data.infocontent}}
            <div class="learningpath-info-block">
                <p> {{{data.infocontent}}} </p>
            </div>
            {{/data.infocontent}}
            {{#data.infobutton}}
                <div class="learningpath-info-btn">
                    <a href="{{{data.nextcourseurl}}}" class="btn btn-primary">{{data.infobutton}}</a>
                </div>
            {{/data.infobutton}}
        </div>
    {{/data.showinfotop}}

    {{#data.showinfosidebar}}
        <button class="btn btn-link sidebar-toggle collapsed" type="button" data-toggle="collapse" data-target="#learningpath-sidebar-{{uniqueid}}" aria-expanded="false" aria-controls="learningpath-sidebar-{{uniqueid}}">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="learningpath-sidebar collapse" id="learningpath-sidebar-{{uniqueid}}">
            <div class="sidebar-content">
                {{! Info area - KPIs, progress, faculty, badges }}
                <div class="learningpath-info-area" id="learningpath-info-area-{{uniqueid}}">
                    {{> dashaddon_learningpath/info_area}}
                </div>

                {{! Course details area - replaces info area when a course is selected }}
                <div class="learningpath-course-details" id="learningpath-course-details-{{uniqueid}}" style="display: none;">
                    <div class="details-header">
                        <button class="btn btn-sm btn-link details-back" type="button" title="{{#str}}backtoinfoarea, block_dash{{/str}}">
                            <i class="fa fa-arrow-left"></i>
                        </button>
                        <h5>{{#str}}coursedetails, block_dash{{/str}}</h5>
                        <button class="btn btn-sm btn-link details-close" type="button" title="{{#str}}closesidebar, block_dash{{/str}}">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                    <div class="details-content" id="learningpath-details-content-{{uniqueid}}">
                        {{! Course details will be loaded here dynamically }}
                    </div>
                </div>
            </div>
        </div>
    {{/data.showinfosidebar}}

    {{#data.pathdesktop}}
        <div class="learning-path-block svg-block d-none d-lg-block d-xl-block"
            id="learningpath-svg-{{uniqueid}}"
            data-svg-index="0"
            data-viewport="desktop">
            {{{data.pathdesktop}}}
        </div>
    {{/data.pathdesktop}}

    {{#data.pathtablet}}
        <div class="learning-path-block svg-block d-none d-md-block d-lg-none d-xl-none"
            id="learningpath-svg-tab-{{uniqueid}}"
            data-svg-index="1"
            data-viewport="tablet">
            {{{data.pathtablet}}}
        </div>
    {{/data.pathtablet}}

    {{#data.pathmobile}}
        <div class="learning-path-block svg-block d-block d-sm-block d-md-none d-lg-none d-xl-none"
            id="learningpath-svg-mob-{{uniqueid}}"
            data-svg-index="2"
            data-viewport="mobile">
            {{{data.pathmobile}}}
        </div>
    {{/data.pathmobile}}

    {{#data}}
        <style>
        
        #learningpath-svg-{{uniqueid}} .course-circle.completed,
        #learningpath-svg-{{uniqueid}} path[mask] {
            stroke: {{completedcirclecolor}} !important;
            -webkit-filter: none;
            filter: none;
        }
        
        #learningpath-svg-{{uniqueid}} .course-circle.inprogress,
        #learningpath-svg-{{uniqueid}} .course-circle.inprogress-flag {
            stroke: {{inprogresscirclecolor}} !important;
            -webkit-filter: none;
            filter: none;
        }
        
        #learningpath-svg-{{uniqueid}} .course-circle.notstarted {
        stroke: {{notstartedcirclecolor}} !important;
        -webkit-filter: none;
        filter: none;
        }
        
        #learningpath-svg-{{uniqueid}} .course-circle.unavailable {
            stroke: {{unavailablecirclecolor}} !important;
            -webkit-filter: none;
            filter: none;
        }
        
        #learningpath-svg-{{uniqueid}} .course-circle.available,
        #learningpath-svg-{{uniqueid}} .course-circle.available-flag {
            stroke: {{availablecirclecolor}} !important;
            -webkit-filter: none;
            filter: none;
        }
        
        #learningpath-svg-{{uniqueid}} .course-circle.failed,
        #learningpath-svg-{{uniqueid}} .course-circle.failed-flag {
            stroke: {{failedcirclecolor}} !important;
            -webkit-filter: none;
            filter: none;
        }
        
        </style>
        {{/data}}

            
    {{#data}}
    {{#data.isvisualnone}}
    <style>

    #learningpath-svg-{{uniqueid}} .course-circle {
        fill: {{completedcirclecolor}};
    }

    #learningpath-svg-{{uniqueid}} .course-circle.completed {
        fill: {{completedcirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.inprogress {
        fill: {{inprogresscirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.notstarted {
        fill: {{notstartedcirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.available {
        fill: {{availablecirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.unavailable {
        fill: {{unavailablecirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.failed {
        fill: {{failedcirclecolor}} !important;
    }
    </style>
    {{/data.isvisualnone}}

    {{#data.isvisualnumber}}
    <style>

    #learningpath-svg-{{uniqueid}} .course-circle {
        fill: {{completedcirclecolor}};
    }

    #learningpath-svg-{{uniqueid}} .course-circle.completed {
        fill: {{completedcirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.inprogress {
        fill: {{inprogresscirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.notstarted {
        fill: {{notstartedcirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.available {
        fill: {{availablecirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.unavailable {
        fill: {{unavailablecirclecolor}} !important;
    }
    #learningpath-svg-{{uniqueid}} .course-circle.failed {
        fill: {{failedcirclecolor}} !important;
    }
    </style>
    {{/data.isvisualnumber}}
    {{/data}}

        {{#data.showinfo}}
        <div class="learning-path-header alert {{#data.completedlearingpath}} alert-success{{/data.completedlearingpath}}{{^data.completedlearingpath}} alert-secondary{{/data.completedlearingpath}}">
            {{#data.infocontent}}
            <div class="learningpath-info-block">
                <p> {{{data.infocontent}}} </p>
            </div>
            {{/data.infocontent}}
            {{#data.infobutton}}
                <div class="learningpath-info-btn">
                    <a href="{{{data.nextcourseurl}}}" class="btn btn-primary">{{data.infobutton}}</a>
                </div>
            {{/data.infobutton}}

            {{#data.showinfo}}
            <div class="kpi-display">
                {{#data.selectedkpi}}
                <p><b>{{data.kpivalue}}</b> <span>{{data.kpilabel}}</span></p>
                {{/data.selectedkpi}}
            </div>
            {{/data.showinfo}}



        </div>
        {{/data.showinfo}}

    <div id="learningpath-gird-{{uniqueid}}" class="learning-path-grid learning-path-block {{^data.pathdesktop}} desktop-show {{/data.pathdesktop}} {{^data.pathtablet}} tablet-show {{/data.pathtablet}} {{^data.pathmobile}} mobile-show {{/data.pathmobile}}">
        {{> dashaddon_learningpath/grid_layout}}
    </div>

</div>

{{#js}}

require(['jquery', 'dashaddon_learningpath/learningpath'], function($, LearnigPath) {
    LearnigPath.init('{{uniqueid}}', {{{data.dataset}}}, {{data.pagecontextid}}, {{data.isgrid}});
});
{{/js}}


{{/data.showlearningpath}}


{{^data.showlearningpath}}
    {{#noresult}}{{{noresult}}}{{/noresult}}
{{/data.showlearningpath}}
